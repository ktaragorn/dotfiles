if [ `uname` = "Darwin" ]
then
	alias subl="reattach-to-user-namespace /Applications/Sublime\ Text.app/Contents/SharedSupport/bin/subl"
	alias gitx="reattach-to-user-namespace gitx"
	alias gitk="wish $(which gitk)"
	alias open="reattach-to-user-namespace open"
	alias ls=eza
	alias cat=bat
	alias tree=broot
	alias cloc="tokei --sort lines"
	alias grep=rg
else
	alias cat=batcat
	alias grep=rg
	pathappend ~/.local/bin
fi
